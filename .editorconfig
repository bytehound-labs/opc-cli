root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.ps1]
# Match the existing PowerShell CRLF rule in .gitattributes.
end_of_line = crlf
indent_size = 4

[*.md]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4
